# Campus Coin (client) — environment variables
# Copy this file to .env.local and fill in real values. Vite only exposes
# variables prefixed with VITE_ to client code.

# Base URL of the backend REST API (not part of this repo yet).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Feature flags — keep AI features off until a provider is wired up server-side.
VITE_FEATURE_AI_CATEGORIZATION=false
VITE_FEATURE_AI_INSIGHTS=false
